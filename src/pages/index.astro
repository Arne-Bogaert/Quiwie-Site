---
import Layout from '../layouts/layout.astro';
import SocialLink from '../components/SocialLink.astro';
import TourList from '../components/TourList.astro';
import { icons } from '../data/icons';
---

<Layout title="Quiwie | Website" description="Quiwie is een Vlaamse band. Kom kijken naar onze shows of luister via SoundCloud.">
  <style>
    .marquee-container {
      width: 100%;
      overflow: hidden;
      background: var(--accent-color);
      color: var(--off-white);
      padding: 14px 0;
      margin-bottom: 40px;
      border-radius: 4px;
      white-space: nowrap;
      border: 3px solid var(--text-color);
      box-shadow: var(--shadow-soft);
      position: relative;
    }

    .marquee-content {
      display: inline-block;
      padding-left: 100%;
      animation: scroll-text 20s linear infinite;
      font-family: 'Fredoka', sans-serif;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.95rem;
      letter-spacing: 3px;
    }

    @keyframes scroll-text {
      0% { transform: translate3d(0, 0, 0); }
      100% { transform: translate3d(-100%, 0, 0); }
    }

    .marquee-container:hover .marquee-content {
      animation-play-state: paused;
      cursor: default;
    }

    .marquee-container:hover {
      transform: rotate(-1deg) scale(1.01);
      box-shadow: var(--shadow-hover);
    }

    /* ---- Footer mark ---- */

    .footer-mark {
      width: 48px;
      height: auto;
      opacity: 1;
      margin-bottom: 12px;
      display: block;
      margin-left: auto;
      margin-right: auto;
      mix-blend-mode: multiply;
    }

    /* ---- Hero ---- */

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 4px;
    }

  </style>

  <div class="container">

    <section class="hero">
      <h1 class="sr-only">Quiwie</h1>
      <div class="logo-header">
        <img src="/img/transparante%20logos/Volledig_Logo_Transparant.webp" alt="Quiwie" class="header-logo" width="1170" height="1060" />
      </div>

    </section>

    <div class="marquee-container scroll-reveal">
      <div class="marquee-content">
        Hallo wij zijn Quiwie &nbsp;·&nbsp; kom kijken naar onze shows! &nbsp;·&nbsp; Hallo wij zijn Quiwie &nbsp;·&nbsp; kom kijken naar onze shows! &nbsp;·&nbsp;
      </div>
    </div>

    <div class="release-header scroll-reveal">
      <h2 class="section-title">Laatste release</h2>
    </div>

    <section class="soundcloud-wrapper scroll-reveal" aria-label="Laatste release">
      <iframe
        width="100%"
        height="120"
        style="border: none;"
        allow="autoplay"
        loading="lazy"
        title="Quiwie op SoundCloud"
        src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/2245918166&color=%23b84d33&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&show_artwork=false"
      ></iframe>
    </section>
    <div class="divider scroll-reveal"></div>

    <section id="tour-dates" class="scroll-reveal">
      <h2 class="section-title">Concerten</h2>
      <TourList />
    </section>

    <div class="divider scroll-reveal"></div>

    <div class="release-header scroll-reveal">
      <h2 class="section-title">Links</h2>
    </div>
    <ul class="links-list scroll-reveal">
      <li><SocialLink
        href="https://instagram.com/quiwie.band"
        svgPath={icons.instagram.path}
        svgWidth={icons.instagram.w}
        svgHeight={icons.instagram.h}
        title="Instagram"
        color="#E4405F"
        platform="instagram"
      /></li>
      <li><SocialLink
        href="https://soundcloud.com/quiwie"
        svgPath={icons.soundcloud.path}
        svgWidth={icons.soundcloud.w}
        svgHeight={icons.soundcloud.h}
        title="SoundCloud"
        color="#FF5500"
        platform="soundcloud"
      /></li>
      <li><SocialLink
        href="https://vi.be/platform/Quiwie"
        imgSrc="https://vi.be/favicon.ico"
        title="VI.BE"
        platform="vibe"
      /></li>
      <li><SocialLink
        href="https://www.facebook.com/profile.php?id=61572077228895"
        svgPath={icons.facebook.path}
        svgWidth={icons.facebook.w}
        svgHeight={icons.facebook.h}
        title="Facebook"
        color="#1877F2"
        platform="facebook"
      /></li>
      <li><SocialLink
        href="mailto:quiwieband@gmail.com"
        svgPath={icons.envelope.path}
        svgWidth={icons.envelope.w}
        svgHeight={icons.envelope.h}
        title="Boekingen & Contact"
        color="var(--text-color)"
        platform="email"
        isExternal={false}
      /></li>
    </ul>

    <footer class="site-footer scroll-reveal">
      <img src="/img/transparante%20logos/Klein_Logo_Transparant.webp" alt="" class="footer-mark" aria-hidden="true" width="1071" height="1214" />
      <p>&copy; 2026 Quiwie</p>
      <p>Site by Arne Bogaert</p>
    </footer>

  </div>
</Layout>
