---
import Layout from '../layouts/layout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="Quiwie - Spotify Rijpt Nog">
  <style>
    .error-container {
      padding-top: 5vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .error-message {
      font-family: 'Comic Neue', cursive;
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1.7;
      margin-bottom: 40px;
      padding: 0 10px;
      color: var(--text-color);
    }
    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background-color: var(--accent-color);
      color: var(--off-white);
      text-decoration: none;
      padding: 16px 32px;
      border-radius: 20px;
      font-family: 'Fredoka', sans-serif;
      font-weight: 600;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                  background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: var(--shadow-soft);
      border: 2px solid var(--text-color);
    }
    .back-button:hover {
      background-color: var(--accent-light);
      transform: translate(-2px, -2px) rotate(-2deg);
      box-shadow: var(--shadow-hover);
    }
    .presave-btn {
      background-color: #1db954;
      margin-bottom: 15px;
    }
    .presave-btn:hover {
      background-color: #17a34a;
    }
  </style>

  <div class="container error-container">
    <h1>Nog even geduld!</h1>

    <div class="error-message">
      <p>Onze excuses voor de radiostilte op Spotify.</p>
      <p>
        We leggen de laatste hand aan de mix zodat jullie binnenkort optimaal
        van ons gejengel kunnen genieten.
      </p>
    </div>

    <a
      href="https://distrokid.com/hyperfollow/quiwie/jouw-link"
      class="back-button presave-btn"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
        <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
      </svg>
      Pre-save op Spotify
    </a>

    <a href={baseUrl} class="back-button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Ik wil terug
    </a>
  </div>
</Layout>
